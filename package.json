{
  "name": "cursor-openai-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI Chat Completions + stateful Responses proxy over the Cursor SDK.",
  "license": "(MIT OR Apache-2.0)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "start:node": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:e2e:live": "LIVE_SMOKE=1 E2E_SPAWN=1 vitest run tests/e2e.test.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0",
    "@hono/node-server": "^1.19.0",
    "effect": "^3.17.0",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
